#Units
UNITS LENGTH=A TIME=fs ENERGY=eV
# Define a distance between atoms 0 and 1
# RESTART
d1: DISTANCE ATOMS=1,8

UPPER_WALLS ARG=d1 AT=3.5 KAPPA=100.0 EXP=2 EPS=1 OFFSET=0 LABEL=uwall

# MetaD 
metad: METAD ARG=d1 SIGMA=0.025 HEIGHT=0.05 PACE=1 FILE=HILLS

# moving restartints
#! rest: MOVINGRESTRAINT ARG=d1 STEP0=0 AT0=1.4 KAPPA0=50.0 STEP1=25 AT1=2.0 KAPPA1=50.0 STEP2=45 AT2=3.0 KAPPA2=50.0

# Print the distance to the screen every 100 steps
PRINT ARG=* FILE=COLVAR STRIDE=1

# Dump CV forces and derivatives for bias force correction
# STRIDE must match aimd_setup.log_frequency in input.yaml (10)
DUMPFORCES ARG=d1 FILE=cv_force STRIDE=1
DUMPDERIVATIVES ARG=d1 FILE=cv_derivs STRIDE=1

# FLUSH data
FLUSH STRIDE=1
