# Quantum ESPRESSO pw.x template for SPARC - Ammonia Borane (NH3BH3)
# PBE functional with ultrasoft pseudopotentials
# ASE handles ATOMIC_POSITIONS and CELL_PARAMETERS automatically.

&CONTROL
  restart_mode = 'from_scratch'
  calculation  = 'scf'
  tprnfor      = .true.
  tstress      = .true.
  pseudo_dir   = '/home/rverma7/Softwares/qe-7.0/pseudo/SSSP_1.3.0_PBE'
  outdir       = './qe_out'
  verbosity    = 'low'
/

&SYSTEM
  ibrav            = 0
  ecutwfc          = 40
  ecutrho          = 320
  occupations      = 'fixed'
/

&ELECTRONS
  conv_thr     = 1.0d-5
  mixing_beta  = 0.3
  electron_maxstep = 100
/

ATOMIC_SPECIES
  B   10.811  b_pbe_v1.4.uspp.F.UPF 
  N   14.007  N.pbe-n-radius_5.UPF 
  H    1.008  H.pbe-rrkjus_psl.1.0.0.UPF 

K_POINTS gamma
