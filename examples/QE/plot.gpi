#!/bin/gnuplot

set grid lw 0.5

set xlabel 'MD Steps'
set ylabel 'Energies [eV]'

set y2label 'Temperature [K]' tc rgb 'red'
set ytics nomirror
set y2tics tc rgb 'red'
set border lc rgb 'black'
set y2range [50:550]

plot \
    'iter_000000/00.dft/AseMolDyn.log' us 1:2 w l lw 2 title 'Potential Energy', \
    '' us 1:4 w l lw 2 title 'Total Energy', \
    '' us 1:5 axes x1y2 w l lw 2 lc rgb 'red' title 'Temperature'
