! This is a comment
# This is a comment
&GLOBAL
ECHO_INPUT
&END GLOBAL
&FORCE_EVAL
&DFT
    CHARGE 0
    MULTIPLICITY 1
&MGRID
    CUTOFF 400
    REL_CUTOFF 50
    NGRIDS 3
&END MGRID
&QS
    METHOD GPW #GAPW
    EPS_DEFAULT 1.0E-10
    EPS_PGF_ORB 1.0E-12
    EXTRAPOLATION ASPC
    EXTRAPOLATION_ORDER 3
&END QS

&SCF
  EPS_SCF 1.0E-4
  &OT
    PRECONDITIONER FULL_ALL
  &END
  &OUTER_SCF
    EPS_SCF 1.0E-4
    MAX_SCF 3
  &END
  SCF_GUESS RESTART
&END SCF
&END DFT

&SUBSYS
    &KIND B
      ELEMENT B
      POTENTIAL GTH-PADE
      BASIS_SET SZV-MOLOPT-SR-GTH
    &END KIND
    &KIND N
      ELEMENT N
      POTENTIAL GTH-PADE
      BASIS_SET SZV-MOLOPT-SR-GTH
    &END KIND
    &KIND H
      ELEMENT H
      POTENTIAL GTH-PADE
      BASIS_SET SZV-MOLOPT-SR-GTH 
    &END KIND
&END SUBSYS
&END FORCE_EVAL
