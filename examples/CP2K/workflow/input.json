{
    "_comment": "DeepMD training config for ammonia borane (NH3BH3). Elements: B, N, H.",

    "model": {
        "type_map": ["B", "N", "H"],
        "descriptor": {
            "type":         "se_e2_a",
            "sel":          "auto",
            "rcut_smth":    0.50,
            "rcut":         6.00,
            "neuron":       [25, 50, 100],
            "resnet_dt":    false,
            "axis_neuron":  16,
            "seed":         42
        },
        "fitting_net": {
            "neuron":       [120, 120, 120],
            "resnet_dt":    true,
            "seed":         42
        }
    },

    "learning_rate": {
        "type":         "exp",
        "decay_steps":  5000,
        "start_lr":     0.001,
        "stop_lr":      3.51e-8
    },

    "loss": {
        "type":         "ener",
        "start_pref_e": 0.02,
        "limit_pref_e": 1,
        "start_pref_f": 1000,
        "limit_pref_f": 1,
        "start_pref_v": 0,
        "limit_pref_v": 0
    },

    "training": {
        "training_data": {
            "systems":      ["00.data/training_data"],
            "batch_size":   "auto"
        },
        "validation_data": {
            "systems":      ["00.data/validation_data"],
            "batch_size":   "auto",
            "numb_btch":    1
        },
        "numb_steps":   100000,
        "seed":         42,
        "disp_file":    "lcurve.out",
        "disp_freq":    1000,
        "save_freq":    10000
    }
}
