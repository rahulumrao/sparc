rd1: READ FILE=COLVAR VALUES=d1 IGNORE_TIME
rs0: READ FILE=COLVAR VALUES=ss.coord-0 IGNORE_TIME
rs7: READ FILE=COLVAR VALUES=ss.coord-7 IGNORE_TIME
rpb: READ FILE=COLVAR VALUES=pb.bias IGNORE_TIME

w: REWEIGHT_METAD ARG=rpb.bias TEMP=300

h: HISTOGRAM ARG=rs0.coord-0,rs7.coord-7 GRID_MIN=1.0,1.0 GRID_MAX=6.0,6.0 GRID_BIN=200,200 BANDWIDTH=0.05,0.05 LOGWEIGHTS=w
fes: CONVERT_TO_FES GRID=h TEMP=300

DUMPGRID GRID=h FILE=histo_ss0_ss7.dat
DUMPGRID GRID=fes FILE=fes_ss0_ss7.dat

d1h: HISTOGRAM ARG=rd1 GRID_MIN=0.10 GRID_MAX=0.60 GRID_BIN=100 BANDWIDTH=0.005 LOGWEIGHTS=w
d1fes: CONVERT_TO_FES GRID=d1h TEMP=300

DUMPGRID GRID=d1fes FILE=fes_d1.dat
