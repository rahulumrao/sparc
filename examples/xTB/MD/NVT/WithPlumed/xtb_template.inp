# xTB template for SPARC - Ammonia Borane (NH3BH3)
# GFN2-xTB semiempirical tight-binding method
# Fast and suitable for prototyping / pre-equilibration

# xTB Hamiltonian to use
method                 = GFN2-xTB

# Total molecular charge
charge                 = 0

# Spin multiplicity: 1 = closed-shell singlet
multiplicity           = 1

# Numerical accuracy level; lower can be faster, higher can be tighter
accuracy               = 1.0

# Electronic temperature in K
electronic_temperature = 300

# Maximum SCF iterations
max_iterations         = 250

# Implicit solvent model; None means gas phase
solvent                = None

# Solvent treatment type; None when no solvent is used
solvent_method         = None

# Working/output directory
directory              = xtb_run

# File prefix / run label
label                  = xtb
